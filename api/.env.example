# ── Database ──────────────────────────────────────────────────────────────────
# Local SQLite (default, no setup needed)
DATABASE_URL=sqlite:///./crimes.db

# Production PostgreSQL (Railway / Supabase / etc.)
# DATABASE_URL=postgresql://user:password@host:5432/crimes_api

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production

# ── AI (Gemini) ───────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Redis Caching (optional) ──────────────────────────────────────────────────
# Leave empty to disable caching gracefully
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_EXPENSIVE=20/minute

# ── API ───────────────────────────────────────────────────────────────────────
API_PREFIX=/api/v1

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
